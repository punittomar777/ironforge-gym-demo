# IronForge Fitness — contact form email (Resend)
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Resend API key — https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY=your_resend_api_key_here

# Verified sender. For quick testing use Resend's shared sender below (no setup):
#   EMAIL_FROM=IronForge Fitness <onboarding@resend.dev>
# For production, verify your own domain in Resend and use an address on it, e.g.:
#   EMAIL_FROM=IronForge Fitness <enquiries@yourgymdomain.com>
EMAIL_FROM=IronForge Fitness <onboarding@resend.dev>

# Where enquiries are delivered — your personal inbox for testing.
EMAIL_TO=your-personal-email@example.com
